# Records to release brakes/stop
# by sending "J/" to motors
#
# % macro, prefix, record prefix
#                  e.g. "TS02K-MO-PMAC-01"          
# % macro, port, powerbrick asyn port from pmacCreateController invocation
#               e.g. "pwbrick"
# % macro, name, gui element

# % gui, $(name), edmembed, IDM_stop.edl, prefix=$(prefix)

record(stringout, "$(prefix):BRAKEREL")
{
    field(DESC, "Send J/ to controller")
    field(DTYP, "asynOctetWrite")
    field(OUT,  "@asyn($(port),0,1)PMAC_C_WRITE_CMD")
    field(SCAN, "Passive")
    field(VAL,  "#1..4J/")
}
